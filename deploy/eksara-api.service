[Unit]
Description=Eksara API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/eksara-print/apps/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/ubuntu/eksara-print/apps/api/dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/eksara-print/apps/api/data

[Install]
WantedBy=multi-user.target
