# --- Server ---
PORT=4000
# Public base URL of this API; used to build presigned-style upload URLs.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (customer web).
WEB_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eksara

# --- Sessions ---
SESSION_SECRET=change-me
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# --- Storage (local dev adapter; replace with S3-compatible storage) ---
STORAGE_DIR=./var/storage

# --- Google OAuth (leave empty to disable Google login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# --- Monad ---
# Testnet chain id 10143, mainnet 143 (see docs/backend-handoff.md).
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=
